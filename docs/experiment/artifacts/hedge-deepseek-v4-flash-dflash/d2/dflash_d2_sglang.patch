+"""Configuration adapter for Speculators DFlash draft checkpoints."""
+
+from __future__ import annotations
+
+from typing import Any, Optional
+
+from transformers import AutoConfig, PretrainedConfig
+
+
+class DFlashConfig(PretrainedConfig):
+    """Normalize the nested config schema emitted by Speculators.
+
+    The draft transformer's HF config lives under ``transformer_layer_config``;
+    SGLang's generic model configuration machinery expects it at
+    ``text_config``.  Keep both names pointing at the same typed config while
+    preserving the DFlash-specific top-level fields.
+    """
+
+    model_type = "dflash"
+
+    def __init__(
+        self,
+        *,
+        transformer_layer_config: Any = None,
+        aux_hidden_state_layer_ids: Optional[list[int]] = None,
+        block_size: int = 8,
+        draft_vocab_size: Optional[int] = None,
+        mask_token_id: Optional[int] = None,
+        sliding_window_non_causal: bool = False,
+        target_hidden_size: Optional[int] = None,
+        **kwargs,
+    ) -> None:
+        super().__init__(**kwargs)
+
+        if transformer_layer_config is None:
+            raise ValueError(
+                "DFLASH requires transformer_layer_config in the draft config."
+            )
+        if isinstance(transformer_layer_config, dict):
+            nested = dict(transformer_layer_config)
+            nested_model_type = nested.pop("model_type", None)
+            if not nested_model_type:
+                raise ValueError(
+                    "DFLASH transformer_layer_config requires model_type."
+                )
+            transformer_layer_config = AutoConfig.for_model(
+                nested_model_type, **nested
+            )
+        if not isinstance(transformer_layer_config, PretrainedConfig):
+            raise ValueError(
+                "DFLASH transformer_layer_config must be a dict or "
+                f"PretrainedConfig, got {type(transformer_layer_config).__name__}."
+            )
+
+        if not aux_hidden_state_layer_ids:
+            raise ValueError(
+                "DFLASH requires non-empty aux_hidden_state_layer_ids."
+            )
+        self.aux_hidden_state_layer_ids = [
+            int(layer_id) for layer_id in aux_hidden_state_layer_ids
+        ]
+
+        self.block_size = int(block_size)
+        if self.block_size <= 1:
+            raise ValueError(
+                f"DFLASH block_size must be greater than one, got {block_size}."
+            )
+
+        self.draft_vocab_size = (
+            None if draft_vocab_size is None else int(draft_vocab_size)
+        )
+        if self.draft_vocab_size is not None and self.draft_vocab_size <= 0:
+            raise ValueError(
+                "DFLASH draft_vocab_size must be positive, "
+                f"got {draft_vocab_size}."
+            )
+
+        self.mask_token_id = (
+            None if mask_token_id is None else int(mask_token_id)
+        )
+        if self.mask_token_id is not None and self.mask_token_id < 0:
+            raise ValueError(
+                f"DFLASH mask_token_id must be non-negative, got {mask_token_id}."
+            )
+
+        self.sliding_window_non_causal = bool(sliding_window_non_causal)
+        self.target_hidden_size = (
+            None if target_hidden_size is None else int(target_hidden_size)
+        )
+        self.transformer_layer_config = transformer_layer_config
+        self.text_config = transformer_layer_config
+
+    @property
+    def target_vocab_size(self) -> int:
+        return int(self.transformer_layer_config.vocab_size)
