+    def test_primary_projection_and_vocab_header_shapes_on_meta(self) -> None:
+        from sglang.srt.configs.dflash import DFlashConfig
+        from sglang.srt.models.dflash import DFlashDraftModel
+        from sglang.srt.runtime_context import get_context, get_parallel
+
+        class ProjectionOnlyDecoderLayer(torch.nn.Module):
+            """Avoid attention kernels while preserving production state names."""
+
+            def __init__(self, config, layer_id, quant_config=None) -> None:
+                super().__init__()
+
+        class ProjectionOnlyDFlashDraftModel(DFlashDraftModel):
+            decoder_layer_cls = ProjectionOnlyDecoderLayer
+
+        config = DFlashConfig(**PRIMARY_CONFIG)
+        with torch.device("meta"):
+            with get_context().override_server_args():
+                with get_parallel().override(tp_size=1, tp_rank=0):
+                    model = ProjectionOnlyDFlashDraftModel(config)
+
+        model_state = {
+            **dict(model.named_parameters()),
+            **dict(model.named_buffers()),
+        }
+        expected_shapes = {
+            "fc.weight": [4096, 81920],
+            "embed_tokens.weight": [129280, 4096],
+            "lm_head.weight": [32000, 4096],
+            "t2d": [129280],
+            "d2t": [32000],
+        }
+        self.assertEqual(
+            {
+                name: list(model_state[name].shape)
+                for name in expected_shapes
+            },
+            expected_shapes,
+        )
+        self.assertEqual(model.target_feature_width, 16384)
+        self.assertEqual(model.num_context_features, 5)
+        self.assertEqual(model.block_size, 8)
+
+        model.load_weights(
+            [
+                (name, torch.empty(shape, device="meta"))
+                for name, shape in expected_shapes.items()
+            ]
+        )
