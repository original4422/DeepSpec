+    def test_draft_model_uses_mhc_projection_and_primary_vocab_weights(
+        self,
+    ) -> None:
+        from sglang.srt.configs.dflash import DFlashConfig
+        from sglang.srt.models.dflash import DFlashDraftModel
+        from sglang.srt.models.registry import ModelRegistry
+        from sglang.srt.runtime_context import get_context, get_parallel
+
+        tiny = dict(PRIMARY_CONFIG)
+        tiny["aux_hidden_state_layer_ids"] = [0, 1]
+        tiny["draft_vocab_size"] = 6
+        tiny["num_target_layers"] = 2
+        tiny["transformer_layer_config"] = {
+            "attention_bias": False,
+            "bos_token_id": 1,
+            "eos_token_id": 2,
+            "hc_mult": 4,
+            "head_dim": 4,
+            "hidden_act": "silu",
+            "hidden_size": 8,
+            "intermediate_size": 16,
+            "layer_types": ["sliding_attention"],
+            "max_position_embeddings": 64,
+            "model_type": "llama",
+            "num_attention_heads": 2,
+            "num_hidden_layers": 1,
+            "num_key_value_heads": 1,
+            "rms_norm_eps": 1e-6,
+            "rope_parameters": {
+                "rope_theta": 10000,
+                "rope_type": "default",
+            },
+            "sliding_window": 16,
+            "vocab_size": 10,
+        }
+        config = DFlashConfig(**tiny)
+
+        class ProjectionOnlyDecoderLayer(torch.nn.Module):
+            """CPU fixture: projection/vocab seam does not require attention."""
+
+            def __init__(self, config, layer_id, quant_config=None) -> None:
+                super().__init__()
+
+        class ProjectionOnlyDFlashDraftModel(DFlashDraftModel):
+            decoder_layer_cls = ProjectionOnlyDecoderLayer
+
+        with get_context().override_server_args():
+            with get_parallel().override(tp_size=1, tp_rank=0):
+                model = ProjectionOnlyDFlashDraftModel(config)
+
+        resolved_cls, resolved_arch = ModelRegistry.resolve_model_cls(
+            ["DFlashDraftModel"]
+        )
+        self.assertIs(resolved_cls, DFlashDraftModel)
+        self.assertEqual(resolved_arch, "DFlashDraftModel")
+
+        self.assertEqual(model.target_feature_width, 32)
+        self.assertEqual(model.num_context_features, 2)
+        self.assertEqual(list(model.fc.weight.shape), [8, 64])
+        self.assertEqual(list(model.embed_tokens.weight.shape), [10, 8])
+        self.assertEqual(list(model.lm_head.weight.shape), [6, 8])
+        self.assertEqual(list(model.t2d.shape), [10])
+        self.assertEqual(list(model.d2t.shape), [6])
+
+        fc_weight = torch.arange(8 * 64, dtype=torch.float32).view(8, 64)
+        embed_weight = torch.arange(10 * 8, dtype=torch.float32).view(10, 8)
+        lm_head_weight = torch.arange(6 * 8, dtype=torch.float32).view(6, 8)
+        t2d = torch.tensor(
+            [True, False, True, False, True, False, True, False, True, True]
+        )
+        d2t = torch.tensor([0, 2, 4, 6, 8, 9], dtype=torch.int64)
+        model.load_weights(
+            [
+                ("fc.weight", fc_weight),
+                ("embed_tokens.weight", embed_weight),
+                ("lm_head.weight", lm_head_weight),
+                ("t2d", t2d),
+                ("d2t", d2t),
+            ]
+        )
+        self.assertTrue(torch.equal(model.fc.weight, fc_weight))
+        self.assertTrue(torch.equal(model.embed_tokens.weight, embed_weight))
+        self.assertTrue(torch.equal(model.lm_head.weight, lm_head_weight))
+        self.assertTrue(torch.equal(model.t2d, t2d))
+        self.assertTrue(torch.equal(model.d2t, d2t))
+        self.assertEqual(
+            model.draft_to_target_tokens(torch.tensor([0, 5])).tolist(),
+            [0, 9],
+        )
+
+        projected = model.project_target_hidden(torch.ones(2, 64))
+        self.assertEqual(list(projected.shape), [2, 8])
+        with self.assertRaisesRegex(
+            ValueError,
+            r"Expected fc.weight.shape=\(8, 64\)",
+        ):
+            model.load_weights(
+                [("fc.weight", torch.empty(8, 16))]
+            )
