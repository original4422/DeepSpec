+class TestDeepSeekV4PrimaryDFlashConfig(unittest.TestCase):
+    def test_production_loader_normalizes_primary_schema(self) -> None:
+        from sglang.srt.configs.model_config import ModelConfig
+        from sglang.srt.speculative.dflash_utils import (
+            parse_dflash_draft_config,
+        )
+
+        with tempfile.TemporaryDirectory() as temp_dir:
+            config_path = Path(temp_dir) / "config.json"
+            config_path.write_text(
+                json.dumps(PRIMARY_CONFIG), encoding="utf-8"
+            )
+            model_config = ModelConfig(
+                model_path=temp_dir,
+                trust_remote_code=False,
+                is_draft_model=True,
+                speculative_algorithm="DFLASH",
+            )
+
+        parsed = parse_dflash_draft_config(
+            draft_hf_config=model_config.hf_config
+        )
+        self.assertEqual(model_config.hf_config.architectures, ["DFlashDraftModel"])
+        self.assertEqual(model_config.hidden_size, 4096)
+        self.assertEqual(model_config.num_hidden_layers, 5)
+        self.assertEqual(model_config.vocab_size, 129280)
+        self.assertEqual(parsed.require_num_layers(), 5)
+        self.assertEqual(parsed.target_layer_ids, [3, 13, 23, 32, 42])
+        self.assertEqual(parsed.resolve_block_size(), 8)
+        self.assertEqual(parsed.mask_token_id, 1)
+        self.assertEqual(
+            model_config.hf_config.draft_vocab_size,
+            32000,
+        )
+        self.assertFalse(
+            model_config.hf_config.sliding_window_non_causal
+        )
+        self.assertEqual(
+            model_config.hf_text_config.sliding_window,
+            2048,
+        )
+
+    def test_deepseek_v4_capture_keeps_layer_ids_and_flattens_mhc(self) -> None:
+        from sglang.srt.models.deepseek_v4 import (
+            DeepseekV4ForCausalLM,
+            flatten_dflash_mhc_hidden_state,
+        )
+
+        wrapper = DeepseekV4ForCausalLM.__new__(DeepseekV4ForCausalLM)
+        torch.nn.Module.__init__(wrapper)
+        wrapper.pp_group = SimpleNamespace(is_last_rank=True)
+        wrapper.capture_aux_hidden_states = False
+        wrapper.model = SimpleNamespace(dflash_layers_to_capture=None)
+
+        layer_ids = [3, 13, 23, 32, 42]
+        wrapper.set_dflash_layers_to_capture(layer_ids)
+
+        self.assertTrue(wrapper.capture_aux_hidden_states)
+        self.assertEqual(wrapper.model.dflash_layers_to_capture, layer_ids)
+
+        completed = torch.tensor(
+            [
+                [[0, 1, 2], [10, 11, 12], [20, 21, 22], [30, 31, 32]],
+                [
+                    [100, 101, 102],
+                    [110, 111, 112],
+                    [120, 121, 122],
+                    [130, 131, 132],
+                ],
+            ]
+        )
+        flattened = flatten_dflash_mhc_hidden_state(
+            completed,
+            expected_hc_mult=4,
+            expected_hidden_size=3,
+        )
+        self.assertEqual(list(flattened.shape), [2, 12])
+        self.assertEqual(
+            flattened.tolist(),
+            [
+                [0, 1, 2, 10, 11, 12, 20, 21, 22, 30, 31, 32],
+                [
+                    100,
+                    101,
+                    102,
+                    110,
+                    111,
+                    112,
+                    120,
+                    121,
+                    122,
+                    130,
+                    131,
+                    132,
+                ],
+            ],
+        )
+        with self.assertRaisesRegex(ValueError, r"expected \[N, 4, 3\]"):
+            flatten_dflash_mhc_hidden_state(
+                completed.to(torch.float32).mean(dim=1),
+                expected_hc_mult=4,
+                expected_hidden_size=3,
+            )
