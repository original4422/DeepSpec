+def populate_dflash_candidate_block(
+    *,
+    candidates: torch.Tensor,
+    current_tokens: torch.Tensor,
+    draft_token_ids: torch.Tensor,
+    draft_model,
+) -> torch.Tensor:
+    """Build ``[current, draft...]`` in the target model's token-id space."""
+    if candidates.ndim != 2 or draft_token_ids.ndim != 2:
+        raise ValueError(
+            "DFLASH candidate and draft-token tensors must both be 2D."
+        )
+    if current_tokens.ndim != 1:
+        raise ValueError("DFLASH current_tokens must be 1D.")
+    expected_draft_shape = (int(candidates.shape[0]), int(candidates.shape[1]) - 1)
+    if tuple(draft_token_ids.shape) != expected_draft_shape:
+        raise ValueError(
+            "DFLASH draft-token shape mismatch: "
+            f"expected {expected_draft_shape}, got {tuple(draft_token_ids.shape)}."
+        )
+    if int(current_tokens.shape[0]) != int(candidates.shape[0]):
+        raise ValueError(
+            "DFLASH current-token batch size does not match candidates."
+        )
+
+    if getattr(draft_model, "has_own_vocab", False):
+        draft_token_ids = draft_model.draft_to_target_tokens(draft_token_ids)
+    candidates[:, 0].copy_(current_tokens)
+    candidates[:, 1:].copy_(draft_token_ids)
+    return candidates
+
