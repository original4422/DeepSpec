+"""HEDGE adapter for the fixed greedy Eagle3 top-k-one verify seam."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, replace
+import json
+import math
+import os
+from typing import Callable, Mapping, Optional
+
+import torch
+
+from sglang.srt.speculative.hedge_spec.config import HedgeConfig
+from sglang.srt.speculative.hedge_spec.torch_rule import choose_prefix_batch
+
+
+HEDGE_MODE_DISABLED = "disabled"
+HEDGE_MODE_B0 = "b0"
+HEDGE_MODE_ENABLED = "enabled"
+_HEDGE_MODES = {
+    HEDGE_MODE_DISABLED,
+    HEDGE_MODE_B0,
+    HEDGE_MODE_ENABLED,
+}
+_MODE_ENV = "SGLANG_EAGLE3_HEDGE_MODE"
+_CONFIG_ENV = "SGLANG_EAGLE3_HEDGE_CONFIG_JSON"
+_TRACE_CAPACITY_ENV = "SGLANG_EAGLE3_HEDGE_TRACE_CAPACITY"
+
+
+@dataclass(frozen=True, slots=True)
+class Eagle3HedgeSettings:
+    mode: str = HEDGE_MODE_DISABLED
+    config: Optional[HedgeConfig] = None
+    trace_capacity: int = 4096
+
+    def __post_init__(self) -> None:
+        if self.mode not in _HEDGE_MODES:
+            raise ValueError(
+                f"Eagle3 HEDGE mode must be one of {sorted(_HEDGE_MODES)}"
+            )
+        if self.mode == HEDGE_MODE_DISABLED and self.config is not None:
+            raise ValueError("disabled Eagle3 HEDGE mode cannot carry config")
+        if self.mode != HEDGE_MODE_DISABLED and self.config is None:
+            raise ValueError("active Eagle3 HEDGE mode requires config")
+        if self.mode == HEDGE_MODE_B0 and self.config.B != 0.0:
+            raise ValueError("Eagle3 B0 mode requires B=0")
+        if self.mode == HEDGE_MODE_ENABLED and self.config.B <= 0.0:
+            raise ValueError("enabled Eagle3 HEDGE mode requires B>0")
+        if self.config is not None and self.config.m != 1:
+            raise ValueError("Eagle3 HEDGE experiment requires m=1")
+        if (
+            isinstance(self.trace_capacity, bool)
+            or not isinstance(self.trace_capacity, int)
+            or self.trace_capacity < 0
+        ):
+            raise ValueError("Eagle3 HEDGE trace_capacity must be non-negative")
+
+    @property
+    def active(self) -> bool:
+        return self.mode != HEDGE_MODE_DISABLED
+
+    @classmethod
+    def from_environ(
+        cls, environ: Optional[Mapping[str, str]] = None
+    ) -> "Eagle3HedgeSettings":
+        values = os.environ if environ is None else environ
+        mode = values.get(_MODE_ENV, HEDGE_MODE_DISABLED).strip().lower()
+        raw_config = values.get(_CONFIG_ENV)
+        try:
+            trace_capacity = int(values.get(_TRACE_CAPACITY_ENV, "0"))
+        except ValueError as error:
+            raise ValueError(
+                f"{_TRACE_CAPACITY_ENV} must be an integer"
+            ) from error
+        if mode == HEDGE_MODE_DISABLED:
+            if raw_config not in (None, ""):
+                raise ValueError(
+                    f"{_CONFIG_ENV} is invalid in disabled mode"
+                )
+            return cls(mode=mode, trace_capacity=trace_capacity)
+        if raw_config in (None, ""):
+            raise ValueError(f"{mode} mode requires {_CONFIG_ENV}")
+        try:
+            payload = json.loads(raw_config)
+        except json.JSONDecodeError as error:
+            raise ValueError(
+                f"{_CONFIG_ENV} must be valid JSON"
+            ) from error
+        if not isinstance(payload, dict):
+            raise ValueError(f"{_CONFIG_ENV} must be a JSON object")
+        return cls(
+            mode=mode,
+            config=HedgeConfig.from_mapping(payload),
+            trace_capacity=trace_capacity,
+        )
+
+
+def build_eagle3_hedge_adapter(
+    *,
+    server_args,
+    tp_rank: int,
+    device: torch.device | str,
+    environ: Optional[Mapping[str, str]] = None,
+) -> Optional["Eagle3HedgeAdapter"]:
+    """Build the experiment adapter while preserving generic Eagle3 defaults."""
+
+    settings = Eagle3HedgeSettings.from_environ(environ)
+    if not settings.active and settings.trace_capacity == 0:
+        return None
+    required = (
+        ("speculative_num_steps", 3, "num_steps=3"),
+        ("speculative_eagle_topk", 1, "topk=1"),
+        ("speculative_num_draft_tokens", 4, "verify_width=4"),
+        ("disable_cuda_graph", True, "disable_cuda_graph=True"),
+        (
+            "disable_overlap_schedule",
+            True,
+            "disable_overlap_schedule=True",
+        ),
+        ("max_running_requests", 1, "max_running_requests=1"),
+    )
+    for field, expected, contract in required:
+        actual = getattr(server_args, field, None)
+        if actual != expected:
+            raise ValueError(
+                "Eagle3 HEDGE experiment requires "
+                f"{contract}, got {field}={actual!r}"
+            )
+    if tp_rank != 0 and settings.trace_capacity:
+        settings = replace(settings, trace_capacity=0)
+    return Eagle3HedgeAdapter(
+        settings=settings,
+        proposal_width=3,
+        verify_width=4,
+        device=device,
+    )
+
+
+class Eagle3HedgeAdapter:
+    """Own request budgets and produce the accepted top-k-one chain."""
+
+    _TI_VALID = 0
+    _TI_ORDINAL = 1
+    _TI_SLOT = 2
+    _TI_SERIAL = 3
+    _TI_STRICT = 4
+    _TI_ACCEPTED = 5
+    _TI_COMMIT = 6
+    _TI_BARRIER = 7
+    _TI_RELAXED = 8
+    _TI_DRAFT = 9
+    _TI_TOP_ID = 12
+    _TRACE_INT_FIELDS = 15
+
+    _TF_TOP_LOGIT = 0
+    _TF_DRAFT_LOGIT = 3
+    _TF_REGRET = 6
+    _TF_VALUE = 9
+    _TF_SPENT = 12
+    _TF_REMAINING_BEFORE = 13
+    _TF_REMAINING_AFTER = 14
+    _TF_BARRIER_REGRET = 15
+    _TF_BARRIER_VALUE = 16
+    _TF_BARRIER_RATIO = 17
+    _TRACE_FLOAT_FIELDS = 18
+
+    @property
+    def active(self) -> bool:
+        return self.settings.active
+
+    def __init__(
+        self,
+        *,
+        settings: Eagle3HedgeSettings,
+        proposal_width: int,
+        verify_width: int,
+        device: torch.device | str,
+    ) -> None:
+        self.settings = settings
+        self.proposal_width = int(proposal_width)
+        self.verify_width = int(verify_width)
+        self.device = torch.device(device)
+        if self.proposal_width != 3 or self.verify_width != 4:
+            raise ValueError(
+                "Eagle3 HEDGE requires proposal_width=3 and verify_width=4"
+            )
+        if self.settings.config is not None:
+            self.settings.config.validate_block_size(self.proposal_width)
+        self._remaining_budget: Optional[torch.Tensor] = None
+        self._active_slots: Optional[torch.Tensor] = None
+        self._request_serial_by_slot: Optional[torch.Tensor] = None
+        self._rid_to_slot: dict[str, int] = {}
+        self._slot_to_rid: dict[int, str] = {}
+        self._serial_to_rid: dict[int, str] = {}
+        self._next_request_serial = 1
+        self._requests_finished = 0
+        self._requests_non_natural = 0
+        self._slot_reuse_resets = 0
+        self._budget_exhaustion_events = torch.zeros(
+            (), dtype=torch.int64, device=self.device
+        )
+        trace_rows = self.settings.trace_capacity + 1
+        self._trace_cursor = torch.zeros(
+            (), dtype=torch.int64, device=self.device
+        )
+        self._trace_dropped = torch.zeros(
+            (), dtype=torch.int64, device=self.device
+        )
+        self._trace_int = torch.zeros(
+            (trace_rows, self._TRACE_INT_FIELDS),
+            dtype=torch.int64,
+            device=self.device,
+        )
+        self._trace_float = torch.full(
+            (trace_rows, self._TRACE_FLOAT_FIELDS),
+            float("nan"),
+            dtype=torch.float64,
+            device=self.device,
+        )
+
+    def bind_request_batch(
+        self,
+        *,
+        rids: list[str],
+        slots: list[int],
+        pool_capacity: int,
+    ) -> None:
+        if len(rids) != len(slots):
+            raise ValueError("request and slot counts differ")
+        if self._active_slots is None:
+            self._active_slots = torch.zeros(
+                (pool_capacity,), dtype=torch.bool, device=self.device
+            )
+            self._request_serial_by_slot = torch.full(
+                (pool_capacity,), -1, dtype=torch.int64, device=self.device
+            )
+            if self.settings.active:
+                self._remaining_budget = torch.zeros(
+                    (pool_capacity,),
+                    dtype=torch.float64,
+                    device=self.device,
+                )
+        elif self._active_slots.shape[0] != pool_capacity:
+            raise RuntimeError("request-pool capacity changed")
+        for rid, slot in zip(rids, slots):
+            old_rid = self._slot_to_rid.get(slot)
+            if old_rid == rid:
+                continue
+            if old_rid is not None:
+                self._rid_to_slot.pop(old_rid, None)
+                self._clear_slot(slot)
+                self._slot_reuse_resets += 1
+            old_slot = self._rid_to_slot.get(rid)
+            if old_slot is not None and old_slot != slot:
+                self._clear_slot(old_slot)
+                self._slot_to_rid.pop(old_slot, None)
+            self._rid_to_slot[rid] = slot
+            self._slot_to_rid[slot] = rid
+            serial = self._next_request_serial
+            self._next_request_serial += 1
+            self._serial_to_rid[serial] = rid
+            slot_index = torch.tensor(
+                [slot], dtype=torch.int64, device=self.device
+            )
+            self._active_slots.index_fill_(0, slot_index, True)
+            self._request_serial_by_slot.index_fill_(0, slot_index, serial)
+            if self._remaining_budget is not None:
+                self._remaining_budget.index_fill_(
+                    0, slot_index, self.settings.config.B
+                )
+
+    def bind_batch(self, batch) -> None:
+        """Bind a ScheduleBatch at the low-frequency prefill lifecycle seam."""
+
+        if not batch.reqs:
+            return
+        mirror = getattr(batch, "req_pool_indices_cpu", None)
+        if mirror is not None:
+            slots = [int(value) for value in mirror]
+        else:
+            slots = [req.req_pool_idx for req in batch.reqs]
+            if any(slot is None for slot in slots):
+                raise RuntimeError(
+                    "Eagle3 HEDGE prefill saw an unallocated request"
+                )
+            slots = [int(slot) for slot in slots]
+        pool = batch.req_to_token_pool
+        capacity = (
+            int(pool._alloc_size)
+            if hasattr(pool, "_alloc_size")
+            else int(pool.size) + 1
+        )
+        self.bind_request_batch(
+            rids=[str(req.rid) for req in batch.reqs],
+            slots=slots,
+            pool_capacity=capacity,
+        )
+
+    def _clear_slot(self, slot: int) -> None:
+        if self._active_slots is None:
+            return
+        slot_index = torch.tensor(
+            [slot], dtype=torch.int64, device=self.device
+        )
+        if self._remaining_budget is not None:
+            self._remaining_budget.index_fill_(0, slot_index, 0.0)
+        self._active_slots.index_fill_(0, slot_index, False)
+        self._request_serial_by_slot.index_fill_(0, slot_index, -1)
+
+    def note_request_finished(self, *, rid: str, natural_stop: bool) -> None:
+        """Clear request-owned state on natural finish, cancellation, or abort."""
+
+        slot = self._rid_to_slot.pop(rid, None)
+        if slot is None:
+            return
+        self._slot_to_rid.pop(slot, None)
+        self._clear_slot(slot)
+        self._requests_finished += 1
+        if not natural_stop:
+            self._requests_non_natural += 1
+
+    def _compact_scores(
+        self,
+        *,
+        candidates: torch.Tensor,
+        target_logits: torch.Tensor,
+    ) -> tuple[
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+    ]:
+        if tuple(candidates.shape[1:]) != (self.verify_width,):
+            raise ValueError("Eagle3 candidates must be [batch, 4]")
+        batch = candidates.shape[0]
+        if (
+            target_logits.ndim != 2
+            or target_logits.shape[0] != batch * self.verify_width
+        ):
+            raise ValueError(
+                "Eagle3 target logits must be [batch*4, vocab]"
+            )
+        logits = target_logits.view(batch, self.verify_width, -1)
+        top_logits, top_token_ids = logits.max(dim=-1)
+        draft_token_ids = candidates[:, 1:]
+        draft_logits = logits[:, : self.proposal_width].gather(
+            -1, draft_token_ids.unsqueeze(-1)
+        )
+        return (
+            draft_token_ids,
+            top_logits[:, : self.proposal_width],
+            top_token_ids[:, : self.proposal_width],
+            draft_logits.squeeze(-1),
+            top_token_ids,
+        )
+
+    def _assert_chain(
+        self,
+        *,
+        retrieve_index: torch.Tensor,
+        retrieve_next_token: torch.Tensor,
+        retrieve_next_sibling: torch.Tensor,
+    ) -> None:
+        batch = retrieve_index.shape[0]
+        expected_index = torch.arange(
+            batch * self.verify_width,
+            dtype=retrieve_index.dtype,
+            device=retrieve_index.device,
+        ).view(batch, self.verify_width)
+        expected_next = torch.tensor(
+            [1, 2, 3, -1],
+            dtype=retrieve_next_token.dtype,
+            device=retrieve_next_token.device,
+        ).expand(batch, -1)
+        torch._assert_async(
+            (retrieve_index == expected_index).all(),
+            "Eagle3 HEDGE requires contiguous top-k-one nodes",
+        )
+        torch._assert_async(
+            (retrieve_next_token == expected_next).all(),
+            "Eagle3 HEDGE requires a linear top-k-one chain",
+        )
+        torch._assert_async(
+            (retrieve_next_sibling == -1).all(),
+            "Eagle3 HEDGE does not support sibling branches",
+        )
+
+    def _record_trace(
+        self,
+        *,
+        slots: torch.Tensor,
+        draft_token_ids: torch.Tensor,
+        top_logits: torch.Tensor,
+        top_token_ids: torch.Tensor,
+        draft_logits: torch.Tensor,
+        regrets: torch.Tensor,
+        values: torch.Tensor,
+        strict: torch.Tensor,
+        accepted: torch.Tensor,
+        relaxed: torch.Tensor,
+        spent: Optional[torch.Tensor],
+        remaining_before: Optional[torch.Tensor],
+        remaining_after: Optional[torch.Tensor],
+    ) -> None:
+        if self.settings.trace_capacity == 0:
+            return
+        batch = draft_token_ids.shape[0]
+        ordinal = self._trace_cursor + torch.arange(
+            batch, dtype=torch.int64, device=draft_token_ids.device
+        )
+        in_capacity = ordinal < self.settings.trace_capacity
+        safe_ordinal = ordinal.clamp(max=self.settings.trace_capacity)
+        if self._request_serial_by_slot is None:
+            serial = torch.full_like(slots, -1, dtype=torch.int64)
+        else:
+            serial = self._request_serial_by_slot.index_select(
+                0, slots.to(torch.int64)
+            )
+        barrier = strict.to(torch.int64)
+        safe_barrier = barrier.clamp(max=self.proposal_width - 1)
+        row = torch.arange(
+            batch, dtype=torch.int64, device=draft_token_ids.device
+        )
+        barrier_regret = regrets[row, safe_barrier]
+        barrier_value = values[row, safe_barrier]
+        barrier_ratio = barrier_regret / barrier_value
+        no_risk = torch.full_like(barrier_regret, torch.nan)
+        spent_field = no_risk if spent is None else spent.to(torch.float64)
+        before_field = (
+            no_risk
+            if remaining_before is None
+            else remaining_before.to(torch.float64)
+        )
+        after_field = (
+            no_risk
+            if remaining_after is None
+            else remaining_after.to(torch.float64)
+        )
+
+        trace_int = self._trace_int
+        trace_int[safe_ordinal, self._TI_VALID] = in_capacity.to(torch.int64)
+        trace_int[safe_ordinal, self._TI_ORDINAL] = ordinal
+        trace_int[safe_ordinal, self._TI_SLOT] = slots
+        trace_int[safe_ordinal, self._TI_SERIAL] = serial
+        trace_int[safe_ordinal, self._TI_STRICT] = strict.to(torch.int64)
+        trace_int[safe_ordinal, self._TI_ACCEPTED] = accepted.to(torch.int64)
+        trace_int[safe_ordinal, self._TI_COMMIT] = (
+            accepted.to(torch.int64) + 1
+        )
+        trace_int[safe_ordinal, self._TI_BARRIER] = torch.where(
+            barrier < self.proposal_width,
+            barrier,
+            torch.full_like(barrier, -1),
+        )
+        trace_int[safe_ordinal, self._TI_RELAXED] = relaxed.to(torch.int64)
+        trace_int[
+            safe_ordinal,
+            self._TI_DRAFT : self._TI_DRAFT + self.proposal_width,
+        ] = draft_token_ids.to(torch.int64)
+        trace_int[
+            safe_ordinal,
+            self._TI_TOP_ID : self._TI_TOP_ID + self.proposal_width,
+        ] = top_token_ids.to(torch.int64)
+
+        trace_float = self._trace_float
+        trace_float[
+            safe_ordinal,
+            self._TF_TOP_LOGIT : self._TF_TOP_LOGIT + self.proposal_width,
+        ] = top_logits.to(torch.float64)
+        trace_float[
+            safe_ordinal,
+            self._TF_DRAFT_LOGIT : self._TF_DRAFT_LOGIT
+            + self.proposal_width,
+        ] = draft_logits.to(torch.float64)
+        trace_float[
+            safe_ordinal,
+            self._TF_REGRET : self._TF_REGRET + self.proposal_width,
+        ] = regrets.to(torch.float64)
+        trace_float[
+            safe_ordinal,
+            self._TF_VALUE : self._TF_VALUE + self.proposal_width,
+        ] = values.to(torch.float64)
+        trace_float[safe_ordinal, self._TF_SPENT] = spent_field
+        trace_float[
+            safe_ordinal, self._TF_REMAINING_BEFORE
+        ] = before_field
+        trace_float[safe_ordinal, self._TF_REMAINING_AFTER] = after_field
+        trace_float[
+            safe_ordinal, self._TF_BARRIER_REGRET
+        ] = barrier_regret
+        trace_float[safe_ordinal, self._TF_BARRIER_VALUE] = barrier_value
+        trace_float[safe_ordinal, self._TF_BARRIER_RATIO] = barrier_ratio
+        self._trace_cursor.add_(batch)
+        self._trace_dropped.add_((~in_capacity).to(torch.int64).sum())
+
+    def accept_or_native(
+        self,
+        *,
+        candidates: torch.Tensor,
+        target_logits: torch.Tensor,
+        req_pool_indices: torch.Tensor,
+        retrieve_index: torch.Tensor,
+        retrieve_next_token: torch.Tensor,
+        retrieve_next_sibling: torch.Tensor,
+        native_accept: Callable[
+            [], tuple[torch.Tensor, torch.Tensor, torch.Tensor]
+        ],
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        if not self.settings.active:
+            native_result = native_accept()
+            if self.settings.trace_capacity == 0:
+                return native_result
+            self._assert_chain(
+                retrieve_index=retrieve_index,
+                retrieve_next_token=retrieve_next_token,
+                retrieve_next_sibling=retrieve_next_sibling,
+            )
+            (
+                draft_token_ids,
+                top_logits,
+                top_token_ids,
+                draft_logits,
+                _full_top_token_ids,
+            ) = self._compact_scores(
+                candidates=candidates,
+                target_logits=target_logits,
+            )
+            strict = (
+                (draft_token_ids == top_token_ids)
+                .to(torch.int32)
+                .cumprod(dim=1)
+                .sum(dim=1)
+            )
+            native_accepted = native_result[1].to(torch.int32)
+            regrets = (
+                top_logits.to(torch.float64)
+                - draft_logits.to(torch.float64)
+            ).clamp_min(0.0)
+            values = (
+                torch.arange(
+                    self.proposal_width,
+                    0,
+                    -1,
+                    device=target_logits.device,
+                    dtype=torch.float64,
+                )
+                / self.proposal_width
+            ).expand(candidates.shape[0], -1)
+            self._record_trace(
+                slots=req_pool_indices.to(
+                    device=self.device, dtype=torch.int64
+                ),
+                draft_token_ids=draft_token_ids,
+                top_logits=top_logits,
+                top_token_ids=top_token_ids,
+                draft_logits=draft_logits,
+                regrets=regrets,
+                values=values,
+                strict=strict,
+                accepted=native_accepted,
+                relaxed=torch.zeros_like(native_accepted),
+                spent=None,
+                remaining_before=None,
+                remaining_after=None,
+            )
+            return native_result
+        if self._remaining_budget is None or self._active_slots is None:
+            raise RuntimeError("Eagle3 HEDGE decode preceded request binding")
+        slots = req_pool_indices.to(device=self.device, dtype=torch.int64)
+        torch._assert_async(
+            self._active_slots.index_select(0, slots).all(),
+            "Eagle3 HEDGE saw an inactive request slot",
+        )
+        self._assert_chain(
+            retrieve_index=retrieve_index,
+            retrieve_next_token=retrieve_next_token,
+            retrieve_next_sibling=retrieve_next_sibling,
+        )
+        (
+            draft_token_ids,
+            top_logits,
+            top_token_ids,
+            draft_logits,
+            full_top_token_ids,
+        ) = self._compact_scores(
+            candidates=candidates,
+            target_logits=target_logits,
+        )
+        remaining_before = self._remaining_budget.index_select(0, slots)
+        decision = choose_prefix_batch(
+            draft_token_ids=draft_token_ids,
+            top_logits=top_logits,
+            top_token_ids=top_token_ids,
+            draft_logits=draft_logits,
+            remaining_budget=remaining_before,
+            config=self.settings.config,
+        )
+        accepted = decision.accepted.to(torch.int32)
+        remaining_after = (
+            remaining_before.to(torch.float64) - decision.spent
+        ).clamp_min(0.0)
+        self._remaining_budget.index_copy_(0, slots, remaining_after)
+        self._budget_exhaustion_events.add_(
+            (
+                (remaining_before > 0.0)
+                & (remaining_after <= 0.0)
+                & (decision.spent > 0.0)
+            )
+            .to(torch.int64)
+            .sum()
+        )
+
+        batch = candidates.shape[0]
+        row = torch.arange(batch, device=candidates.device)
+        positions = torch.arange(
+            self.verify_width,
+            device=candidates.device,
+            dtype=torch.int32,
+        ).expand(batch, -1)
+        accept_index = torch.where(
+            positions <= accepted.unsqueeze(1),
+            retrieve_index.to(torch.int32),
+            torch.full_like(retrieve_index, -1, dtype=torch.int32),
+        )
+        predict = torch.zeros(
+            (batch * self.verify_width,),
+            dtype=torch.int32,
+            device=candidates.device,
+        )
+        edge_positions = torch.arange(
+            self.proposal_width, device=candidates.device
+        )
+        edge_source = retrieve_index[:, : self.proposal_width]
+        edge_accepted = edge_positions.unsqueeze(0) < accepted.unsqueeze(1)
+        predict[edge_source[edge_accepted].to(torch.int64)] = (
+            draft_token_ids[edge_accepted].to(torch.int32)
+        )
+        barrier_index = accepted.to(torch.int64)
+        barrier_source = retrieve_index[row, barrier_index].to(torch.int64)
+        barrier_token = full_top_token_ids[row, barrier_index].to(torch.int32)
+        predict[barrier_source] = barrier_token
+
+        strict = (
+            (draft_token_ids == top_token_ids)
+            .to(torch.int32)
+            .cumprod(dim=1)
+            .sum(dim=1)
+        )
+        positions = torch.arange(
+            self.proposal_width,
+            device=candidates.device,
+            dtype=torch.int64,
+        ).unsqueeze(0)
+        relaxed = (
+            decision.mismatched
+            & (positions < accepted.to(torch.int64).unsqueeze(1))
+        ).to(torch.int64).sum(dim=1)
+        self._record_trace(
+            slots=slots,
+            draft_token_ids=draft_token_ids,
+            top_logits=top_logits,
+            top_token_ids=top_token_ids,
+            draft_logits=draft_logits,
+            regrets=decision.regrets,
+            values=decision.values,
+            strict=strict,
+            accepted=accepted,
+            relaxed=relaxed,
+            spent=decision.spent,
+            remaining_before=remaining_before,
+            remaining_after=remaining_after,
+        )
+        return predict, accepted, accept_index
+
+    def snapshot(self) -> dict:
+        remaining = []
+        if self._remaining_budget is not None:
+            for rid, slot in sorted(self._rid_to_slot.items()):
+                remaining.append(
+                    {
+                        "rid": rid,
+                        "request_pool_slot": slot,
+                        "remaining_budget": float(
+                            self._remaining_budget[slot]
+                        ),
+                    }
+                )
+        seen = int(self._trace_cursor.detach().cpu().item())
+        stored = min(seen, self.settings.trace_capacity)
+        int_rows = self._trace_int[:stored].detach().cpu().tolist()
+        float_rows = self._trace_float[:stored].detach().cpu().tolist()
+        trace = []
+        for ints, floats in zip(int_rows, float_rows):
+            if not ints[self._TI_VALID]:
+                continue
+            serial = int(ints[self._TI_SERIAL])
+            barrier_position = int(ints[self._TI_BARRIER])
+            first_barrier = (
+                None
+                if barrier_position < 0
+                else {
+                    "position": barrier_position,
+                    "regret": float(
+                        floats[self._TF_BARRIER_REGRET]
+                    ),
+                    "value": float(floats[self._TF_BARRIER_VALUE]),
+                    "regret_over_value": float(
+                        floats[self._TF_BARRIER_RATIO]
+                    ),
+                }
+            )
+            spent = float(floats[self._TF_SPENT])
+            before = float(floats[self._TF_REMAINING_BEFORE])
+            after = float(floats[self._TF_REMAINING_AFTER])
+            trace.append(
+                {
+                    "schema_version": 1,
+                    "mode": self.settings.mode,
+                    "proposal_id": int(ints[self._TI_ORDINAL]),
+                    "sample_id": self._serial_to_rid.get(serial),
+                    "request_serial": serial,
+                    "request_pool_slot": int(ints[self._TI_SLOT]),
+                    "draft_token_ids": [
+                        int(value)
+                        for value in ints[
+                            self._TI_DRAFT : self._TI_DRAFT
+                            + self.proposal_width
+                        ]
+                    ],
+                    "target_top_token_ids": [
+                        int(value)
+                        for value in ints[
+                            self._TI_TOP_ID : self._TI_TOP_ID
+                            + self.proposal_width
+                        ]
+                    ],
+                    "target_top_logits": [
+                        float(value)
+                        for value in floats[
+                            self._TF_TOP_LOGIT : self._TF_TOP_LOGIT
+                            + self.proposal_width
+                        ]
+                    ],
+                    "target_draft_token_logits": [
+                        float(value)
+                        for value in floats[
+                            self._TF_DRAFT_LOGIT : self._TF_DRAFT_LOGIT
+                            + self.proposal_width
+                        ]
+                    ],
+                    "regrets": [
+                        float(value)
+                        for value in floats[
+                            self._TF_REGRET : self._TF_REGRET
+                            + self.proposal_width
+                        ]
+                    ],
+                    "values": [
+                        float(value)
+                        for value in floats[
+                            self._TF_VALUE : self._TF_VALUE
+                            + self.proposal_width
+                        ]
+                    ],
+                    "strict_accepted_drafts": int(
+                        ints[self._TI_STRICT]
+                    ),
+                    "hedge_accepted_drafts": int(
+                        ints[self._TI_ACCEPTED]
+                    ),
+                    "commit_length": int(ints[self._TI_COMMIT]),
+                    "relaxed_mismatches": int(
+                        ints[self._TI_RELAXED]
+                    ),
+                    "first_strict_rejection": first_barrier,
+                    "spent": None if math.isnan(spent) else spent,
+                    "remaining_before": (
+                        None if math.isnan(before) else before
+                    ),
+                    "remaining_after": (
+                        None if math.isnan(after) else after
+                    ),
+                }
+            )
+        return {
+            "schema_version": 1,
+            "mode": self.settings.mode,
+            "proposal_width": self.proposal_width,
+            "verify_width": self.verify_width,
+            "active_request_states": len(self._rid_to_slot),
+            "remaining_budget_by_request": remaining,
+            "requests_finished": self._requests_finished,
+            "requests_non_natural": self._requests_non_natural,
+            "slot_reuse_resets": self._slot_reuse_resets,
+            "budget_exhaustion_events": int(
+                self._budget_exhaustion_events.detach().cpu().item()
+            ),
+            "trace_rows_seen": seen,
+            "trace_rows_dropped": int(
+                self._trace_dropped.detach().cpu().item()
+            ),
+            "trace": trace,
+        }
+
+    def clear_metrics(self) -> None:
+        """Clear arm trace/counters without changing live request budgets."""
+
+        self._budget_exhaustion_events.zero_()
+        self._trace_cursor.zero_()
+        self._trace_dropped.zero_()
+        self._trace_int.zero_()
+        self._trace_float.fill_(torch.nan)
+        active_rids = set(self._rid_to_slot)
+        self._serial_to_rid = {
+            serial: rid
+            for serial, rid in self._serial_to_rid.items()
+            if rid in active_rids
+        }
