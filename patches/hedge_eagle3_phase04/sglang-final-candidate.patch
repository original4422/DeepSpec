+                    slots=[2],
+                    pool_capacity=8,
+                )
+
+                predict, commit_lens, accept_index = eagle_sample(
+                    verify_input,
+                    batch,
+                    output,
+                    hedge_adapter=adapter,
+                )
+
+                self.assertEqual(commit_lens.tolist(), [accepted_drafts + 1])
+                self.assertEqual(
+                    predict[accept_index[0, : accepted_drafts + 1]].tolist(),
+                    expected_tokens,
+                )
+                trace = adapter.snapshot()["trace"]
+                self.assertEqual(trace[0]["hedge_accepted_drafts"], accepted_drafts)
+                self.assertEqual(trace[0]["commit_length"], accepted_drafts + 1)
+
+    def test_eagle_sample_without_adapter_preserves_native_kernel_tuple(self):
