+            torch.tensor([[0, 1, -1, -1]], dtype=torch.int32),
+        )
+
+        class Adapter:
+            def accept_or_native(inner_self, **kwargs):
+                self.assertIs(kwargs["target_logits"], output.next_token_logits)
+                self.assertTrue(
+                    torch.equal(
+                        kwargs["candidates"],
+                        verify_input.draft_token.reshape(1, 4),
+                    )
+                )
+                self.assertEqual(
+                    kwargs["req_pool_indices"].tolist(), [2]
+                )
+                return sentinel
+
+        with patch(
+            "sglang.srt.speculative.eagle_utils.verify_tree_greedy_func",
+            side_effect=AssertionError("native kernel must not run directly"),
+        ):
+            result = eagle_sample(
+                verify_input,
+                batch,
+                output,
+                hedge_adapter=Adapter(),
+            )
+
+        self.assertIs(result[0], sentinel[0])
+        self.assertEqual(result[1].tolist(), [3])
+        self.assertIs(result[2], sentinel[2])
+
+    def test_eagle_sample_applies_one_bonus_after_zero_middle_or_all_drafts(self):
+        cases = (
+            ("zero", (11, 20, 30, 40), 0, [11]),
+            ("middle", (10, 21, 30, 40), 1, [10, 21]),
+            ("all", (10, 20, 30, 40), 3, [10, 20, 30, 40]),
+        )
+        for rid, target_ids, accepted_drafts, expected_tokens in cases:
+            with self.subTest(rid=rid):
+                verify_input, batch, output = self._fixture()
+                output.next_token_logits.fill_(-100.0)
+                for row, target_id in enumerate(target_ids):
+                    output.next_token_logits[row, target_id] = 10.0
+                adapter = Eagle3HedgeAdapter(
+                    settings=Eagle3HedgeSettings(
+                        mode=HEDGE_MODE_B0,
+                        config=HedgeConfig(
+                            risk_budget=0.0,
+                            max_regret_per_value=0.0,
+                            max_relaxed_mismatches_per_block=1,
+                            block_size=3,
+                        ),
+                    ),
+                    proposal_width=3,
+                    verify_width=4,
+                    device="cpu",
+                )
+                adapter.bind_request_batch(
