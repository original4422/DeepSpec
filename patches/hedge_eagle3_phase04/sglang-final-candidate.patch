+
+def reduce_eagle3_mhc_hidden_state(
+    raw_hidden_state: torch.Tensor,
+    *,
+    hc_mult: int,
+    hidden_size: int,
+) -> torch.Tensor:
+    """Reduce one completed DeepSeek-V4 mHC state for EAGLE3."""
+    if (
+        raw_hidden_state.ndim != 3
+        or raw_hidden_state.shape[1] != hc_mult
+        or raw_hidden_state.shape[2] != hidden_size
+    ):
+        raise ValueError(
+            "expected raw EAGLE3 mHC shape "
+            f"[N,{hc_mult},{hidden_size}], got "
+            f"{list(raw_hidden_state.shape)}"
+        )
+    if raw_hidden_state.dtype != torch.bfloat16:
+        raise ValueError(
+            "expected raw EAGLE3 mHC dtype torch.bfloat16, got "
+            f"{raw_hidden_state.dtype}"
+        )
+    return raw_hidden_state.mean(dim=1)
+
+
+def capture_eagle3_completed_hidden_state(
+    executed_layer_id: int,
+    completed_hidden_state: torch.Tensor,
+    *,
+    logical_layer_ids: List[int],
+    hook_layer_ids: List[int],
+    captured_by_logical_id: dict[int, torch.Tensor],
+    hc_mult: int,
+    hidden_size: int,
+) -> None:
+    """Capture one completed mHC state at an EAGLE3 boundary hook."""
+    if len(logical_layer_ids) != len(hook_layer_ids):
+        raise ValueError(
+            "EAGLE3 logical and hook layer mappings must have equal length."
+        )
+    hook_layer_id = executed_layer_id + 1
+    if hook_layer_id not in hook_layer_ids:
+        return
+    logical_layer_id = logical_layer_ids[hook_layer_ids.index(hook_layer_id)]
+    if logical_layer_id in captured_by_logical_id:
+        raise ValueError(
+            f"duplicate EAGLE3 aux tap at logical layer {logical_layer_id}"
+        )
+    captured_by_logical_id[logical_layer_id] = (
+        reduce_eagle3_mhc_hidden_state(
+            completed_hidden_state,
+            hc_mult=hc_mult,
+            hidden_size=hidden_size,
+        )
+    )
+
+
+def assemble_eagle3_aux_hidden_states(
+    logical_layer_ids: List[int],
+    captured_by_logical_id: dict[int, torch.Tensor],
+    *,
+    hidden_size: int,
+) -> tuple[List[torch.Tensor], torch.Tensor]:
+    """Order reduced EAGLE3 states and expose their structured layout."""
+    if len(logical_layer_ids) != 3:
+        raise ValueError(
+            "DeepSeek-V4 EAGLE3 requires exactly three aux hidden states."
+        )
+    missing = [
+        layer_id
+        for layer_id in logical_layer_ids
+        if layer_id not in captured_by_logical_id
+    ]
+    if missing:
+        raise ValueError(f"missing EAGLE3 aux taps: {missing}")
+    ordered = [
+        captured_by_logical_id[layer_id]
+        for layer_id in logical_layer_ids
+    ]
+    batch_size = ordered[0].shape[0] if ordered[0].ndim > 0 else None
+    expected_shape = [batch_size, hidden_size]
+    for layer_id, hidden_state in zip(logical_layer_ids, ordered):
+        if (
+            hidden_state.ndim != 2
+            or list(hidden_state.shape) != expected_shape
+        ):
+            raise ValueError(
+                "expected reduced EAGLE3 aux shape "
+                f"{expected_shape} at logical layer {layer_id}, got "
+                f"{list(hidden_state.shape)}"
+            )
+        if hidden_state.dtype != torch.bfloat16:
+            raise ValueError(
+                "expected reduced EAGLE3 aux dtype torch.bfloat16 at "
+                f"logical layer {layer_id}, got {hidden_state.dtype}"
+            )
+    devices = {hidden_state.device for hidden_state in ordered}
+    if len(devices) != 1:
+        raise ValueError(
+            f"EAGLE3 aux taps must share one local device, got {devices}"
+        )
+    return ordered, torch.stack(ordered, dim=1)
+
+
+def build_eagle3_aux_trace(
+    *,
+    logical_layer_ids: List[int],
+    hook_layer_ids: List[int],
+    raw_shapes_by_logical_id: dict[int, List[int]],
+    structured_hidden_states: torch.Tensor,
+    runner_hidden_states: torch.Tensor,
+    hc_mult: int,
+    hidden_size: int,
+    tp_rank: int,
+    tp_world_size: int,
+    expected_local_device: torch.device,
+) -> dict[str, Any]:
+    """Validate and describe one TP rank's EAGLE3 aux handoff."""
+    if len(logical_layer_ids) != 3 or len(hook_layer_ids) != 3:
+        raise ValueError("EAGLE3 trace requires exactly three layer mappings.")
+    if hook_layer_ids != [layer_id + 1 for layer_id in logical_layer_ids]:
+        raise ValueError(
+            "EAGLE3 hook IDs must be the after-layer boundaries for the "
+            "logical layer IDs."
+        )
+    if tp_world_size <= 0 or tp_rank < 0 or tp_rank >= tp_world_size:
+        raise ValueError(
+            f"invalid EAGLE3 TP rank {tp_rank}/{tp_world_size}"
+        )
+    raw_shapes = [
+        raw_shapes_by_logical_id.get(layer_id)
+        for layer_id in logical_layer_ids
+    ]
+    expected_raw_shape = [
+        structured_hidden_states.shape[0],
+        hc_mult,
+        hidden_size,
+    ]
+    if any(shape != expected_raw_shape for shape in raw_shapes):
+        raise ValueError(
+            "unexpected EAGLE3 raw aux shapes: "
+            f"expected {expected_raw_shape}, got {raw_shapes}"
+        )
+    expected_structured_shape = [
+        structured_hidden_states.shape[0],
+        3,
+        hidden_size,
+    ]
+    if list(structured_hidden_states.shape) != expected_structured_shape:
+        raise ValueError(
+            "unexpected EAGLE3 structured aux shape: "
+            f"expected {expected_structured_shape}, got "
+            f"{list(structured_hidden_states.shape)}"
+        )
+    expected_runner_shape = [
+        structured_hidden_states.shape[0],
+        3 * hidden_size,
+    ]
+    if list(runner_hidden_states.shape) != expected_runner_shape:
+        raise ValueError(
+            "unexpected EAGLE3 runner aux shape: "
+            f"expected {expected_runner_shape}, got "
+            f"{list(runner_hidden_states.shape)}"
+        )
+    if (
+        structured_hidden_states.dtype != torch.bfloat16
+        or runner_hidden_states.dtype != torch.bfloat16
+    ):
+        raise ValueError(
+            "EAGLE3 aux trace requires BF16 structured and runner tensors."
+        )
+    expected_local_device = torch.device(expected_local_device)
+    if (
+        structured_hidden_states.device != expected_local_device
+        or runner_hidden_states.device != expected_local_device
+    ):
+        raise ValueError(
+            "EAGLE3 aux tensors are not on the current TP rank's local "
+            f"device {expected_local_device}: structured="
+            f"{structured_hidden_states.device}, runner="
+            f"{runner_hidden_states.device}"
+        )
+    return {
+        "tp_rank": tp_rank,
+        "tp_world_size": tp_world_size,
+        "logical_layer_ids": list(logical_layer_ids),
+        "hook_layer_ids": list(hook_layer_ids),
+        "raw_shapes": raw_shapes,
+        "structured_shape": list(structured_hidden_states.shape),
+        "runner_shape": list(runner_hidden_states.shape),
+        "dtype": str(structured_hidden_states.dtype),
+        "device": str(structured_hidden_states.device),
+        "runner_checksum": float(
+            runner_hidden_states.float().sum().item()
+        ),
+    }
+
