+def reduce_eagle3_mhc_hidden_state(
+    raw_hidden_state: torch.Tensor,
+    *,
+    hc_mult: int,
+    hidden_size: int,
+) -> torch.Tensor:
+    """Reduce one completed DeepSeek-V4 mHC state for EAGLE3."""
+    if (
+        raw_hidden_state.ndim != 3
+        or raw_hidden_state.shape[1] != hc_mult
+        or raw_hidden_state.shape[2] != hidden_size
+    ):
+        raise ValueError(
+            "expected raw EAGLE3 mHC shape "
+            f"[N,{hc_mult},{hidden_size}], got "
+            f"{list(raw_hidden_state.shape)}"
+        )
+    if raw_hidden_state.dtype != torch.bfloat16:
+        raise ValueError(
+            "expected raw EAGLE3 mHC dtype torch.bfloat16, got "
+            f"{raw_hidden_state.dtype}"
+        )
+    return raw_hidden_state.mean(dim=1)
+
+
+def capture_eagle3_completed_hidden_state(
+    executed_layer_id: int,
+    completed_hidden_state: torch.Tensor,
+    *,
+    logical_layer_ids: List[int],
+    hook_layer_ids: List[int],
+    captured_by_logical_id: dict[int, torch.Tensor],
+    hc_mult: int,
+    hidden_size: int,
+) -> None:
+    """Capture one completed mHC state at an EAGLE3 boundary hook."""
+    if len(logical_layer_ids) != len(hook_layer_ids):
+        raise ValueError(
+            "EAGLE3 logical and hook layer mappings must have equal length."
+        )
+    hook_layer_id = executed_layer_id + 1
+    if hook_layer_id not in hook_layer_ids:
+        return
+    logical_layer_id = logical_layer_ids[hook_layer_ids.index(hook_layer_id)]
+    if logical_layer_id in captured_by_logical_id:
+        raise ValueError(
+            f"duplicate EAGLE3 aux tap at logical layer {logical_layer_id}"
+        )
+    captured_by_logical_id[logical_layer_id] = (
+        reduce_eagle3_mhc_hidden_state(
+            completed_hidden_state,
+            hc_mult=hc_mult,
+            hidden_size=hidden_size,
+        )
+    )
+
+
+def assemble_eagle3_aux_hidden_states(
+    logical_layer_ids: List[int],
+    captured_by_logical_id: dict[int, torch.Tensor],
+    *,
+    hidden_size: int,
+) -> tuple[List[torch.Tensor], torch.Tensor]:
+    """Order reduced EAGLE3 states and expose their structured layout."""
+    if len(logical_layer_ids) != 3:
+        raise ValueError(
+            "DeepSeek-V4 EAGLE3 requires exactly three aux hidden states."
+        )
+    missing = [
+        layer_id
+        for layer_id in logical_layer_ids
+        if layer_id not in captured_by_logical_id
+    ]
+    if missing:
+        raise ValueError(f"missing EAGLE3 aux taps: {missing}")
+    ordered = [
+        captured_by_logical_id[layer_id]
+        for layer_id in logical_layer_ids
+    ]
+    batch_size = ordered[0].shape[0] if ordered[0].ndim > 0 else None
+    expected_shape = [batch_size, hidden_size]
+    for layer_id, hidden_state in zip(logical_layer_ids, ordered):
+        if (
+            hidden_state.ndim != 2
+            or list(hidden_state.shape) != expected_shape
+        ):
+            raise ValueError(
+                "expected reduced EAGLE3 aux shape "
+                f"{expected_shape} at logical layer {layer_id}, got "
+                f"{list(hidden_state.shape)}"
+            )
+        if hidden_state.dtype != torch.bfloat16:
+            raise ValueError(
+                "expected reduced EAGLE3 aux dtype torch.bfloat16 at "
+                f"logical layer {layer_id}, got {hidden_state.dtype}"
+            )
+    devices = {hidden_state.device for hidden_state in ordered}
+    if len(devices) != 1:
+        raise ValueError(
+            f"EAGLE3 aux taps must share one local device, got {devices}"
+        )
+    return ordered, torch.stack(ordered, dim=1)
+
