+    hidden_size: int,
+    tp_rank: int,
+    tp_world_size: int,
+    expected_local_device: torch.device,
+) -> dict[str, Any]:
+    """Validate and describe one TP rank's EAGLE3 aux handoff."""
+    if len(logical_layer_ids) != 3 or len(hook_layer_ids) != 3:
+        raise ValueError("EAGLE3 trace requires exactly three layer mappings.")
+    if hook_layer_ids != [layer_id + 1 for layer_id in logical_layer_ids]:
+        raise ValueError(
+            "EAGLE3 hook IDs must be the after-layer boundaries for the "
+            "logical layer IDs."
+        )
+    if tp_world_size <= 0 or tp_rank < 0 or tp_rank >= tp_world_size:
+        raise ValueError(
+            f"invalid EAGLE3 TP rank {tp_rank}/{tp_world_size}"
+        )
+    raw_shapes = [
+        raw_shapes_by_logical_id.get(layer_id)
+        for layer_id in logical_layer_ids
+    ]
+    expected_raw_shape = [
+        structured_hidden_states.shape[0],
+        hc_mult,
+        hidden_size,
+    ]
+    if any(shape != expected_raw_shape for shape in raw_shapes):
+        raise ValueError(
+            "unexpected EAGLE3 raw aux shapes: "
+            f"expected {expected_raw_shape}, got {raw_shapes}"
+        )
+    expected_structured_shape = [
+        structured_hidden_states.shape[0],
+        3,
+        hidden_size,
+    ]
+    if list(structured_hidden_states.shape) != expected_structured_shape:
+        raise ValueError(
+            "unexpected EAGLE3 structured aux shape: "
+            f"expected {expected_structured_shape}, got "
+            f"{list(structured_hidden_states.shape)}"
+        )
+    expected_runner_shape = [
+        structured_hidden_states.shape[0],
+        3 * hidden_size,
+    ]
+    if list(runner_hidden_states.shape) != expected_runner_shape:
+        raise ValueError(
+            "unexpected EAGLE3 runner aux shape: "
+            f"expected {expected_runner_shape}, got "
+            f"{list(runner_hidden_states.shape)}"
+        )
+    if (
+        structured_hidden_states.dtype != torch.bfloat16
+        or runner_hidden_states.dtype != torch.bfloat16
+    ):
+        raise ValueError(
+            "EAGLE3 aux trace requires BF16 structured and runner tensors."
+        )
+    expected_local_device = torch.device(expected_local_device)
+    if (
+        structured_hidden_states.device != expected_local_device
+        or runner_hidden_states.device != expected_local_device
+    ):
+        raise ValueError(
+            "EAGLE3 aux tensors are not on the current TP rank's local "
+            f"device {expected_local_device}: structured="
+            f"{structured_hidden_states.device}, runner="
+            f"{runner_hidden_states.device}"
+        )
+    return {
+        "tp_rank": tp_rank,
+        "tp_world_size": tp_world_size,
+        "logical_layer_ids": list(logical_layer_ids),
+        "hook_layer_ids": list(hook_layer_ids),
+        "raw_shapes": raw_shapes,
+        "structured_shape": list(structured_hidden_states.shape),
+        "runner_shape": list(runner_hidden_states.shape),
+        "dtype": str(structured_hidden_states.dtype),
+        "device": str(structured_hidden_states.device),
+        "runner_checksum": float(
+            runner_hidden_states.float().sum().item()
+        ),
+    }
